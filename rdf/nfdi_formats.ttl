@prefix ns1: <http://www.wikidata.org/entity/> .
@prefix ns2: <https://example.org/nfdi_formats/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

ns2:nfdi4bioimage ns1:P2283 ns2:ome-tiff,
        ns2:ome-zarr ;
    schema:name "NFDI4BioImage" .

ns2:tiff ns1:P1195 "btf",
        "tif",
        "tiff" ;
    schema:description "a single binary with a header that points to one or more directories of tagged metadata entries",
        "an image file format for storing raster graphics images" ;
    schema:encodingFormat "image/tiff" ;
    schema:homepage "https://www.loc.gov/preservation/digital/formats/fdd/fdd000022.shtml" ;
    schema:keywords "image" ;
    schema:name "Tag Image File Format" ;
    schema:sameAs ns1:Q215106 .

ns2:zarr ns1:P1195 "zarr" ;
    schema:description "Hierarchy of JSON metadata with chunked binary arrays",
        "Specification for storage of large N-dimensional typed arrays" ;
    schema:encodingFormat [ rdfs:seeAlso "https://github.com/zarr-developers/zarr-specs/issues/123" ] ;
    schema:homepage "https://zarr.dev/" ;
    schema:keywords "n-d array" ;
    schema:name "Zarr" ;
    schema:sameAs ns1:Q130377195 .

ns2:ome-tiff ns1:P1195 "btf",
        "tif",
        "tiff" ;
    ns2:status "acceptable" ;
    schema:description "Domain-specific metadata & data layout for TIFF",
        "optimized for storying, viewing, & sharing large images" ;
    schema:encodingFormat "image/tiff" ;
    schema:isBasedOn "tiff" ;
    schema:keywords "image" ;
    schema:name "OME-TIFF" ;
    schema:sameAs ns1:Q29167443 ;
    schema:seeAlso "https://doi.org/10.5281/zenodo.15479606" .

ns2:ome-zarr ns1:P1195 "ome.zarr",
        "zarr" ;
    ns2:status "recommended" ;
    schema:description "Domain-specific metadata & data layout for Zarr",
        "optimized for storying, viewing, & sharing large images" ;
    schema:encodingFormat [ rdfs:seeAlso "https://github.com/zarr-developers/zarr-specs/issues/123" ] ;
    schema:isBasedOn "zarr" ;
    schema:keywords "image" ;
    schema:name "OME-Zarr" ;
    schema:sameAs ns1:Q126596270 ;
    schema:seeAlso "https://doi.org/10.5281/zenodo.15479606" .

[] schema:hasPart ns2:ome-tiff,
        ns2:ome-zarr,
        ns2:tiff,
        ns2:zarr .

[] schema:description "A list of NFDI organizations and the file formats they use." ;
    schema:hasPart ns2:nfdi4bioimage ;
    schema:name "NFDI organizations and the file formats they use" .

